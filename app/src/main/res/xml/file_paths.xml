<?xml version="1.0" encoding="utf-8"?>
<!--
  What Whisper is willing to hand to another app.

  Two directories, each holding one kind of file: the diagnostics report
  written by the "Report a problem" action, and the one picture shared from
  the reader's picture viewer. Nothing else in the app's storage is exposed —
  a provider scoped to the whole cache or files directory would also expose
  every cached article body and every downloaded image.
-->
<paths>
    <cache-path
        name="diagnostics"
        path="diagnostics/" />
    <cache-path
        name="shared_pictures"
        path="shared_pictures/" />
</paths>
