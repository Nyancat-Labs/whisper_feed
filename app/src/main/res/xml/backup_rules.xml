<?xml version="1.0" encoding="utf-8"?>
<!--
    What may travel, once the reader has agreed to it at all. Whether a backup
    happens is PlatformBackupAgent's decision; this is what is in it when it
    does.

    The account files never travel, on any route and whatever the reader
    chose: whisper_account_sealed, and whisper_account, the older
    EncryptedSharedPreferences file it replaced. Both are sealed with a key in
    the hardware-backed Keystore, and the Keystore is not part of a backup — so
    a restored device would get the ciphertext without the key, which could
    never be opened. Signing in again is the honest outcome.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="whisper_account.xml" />
    <exclude domain="sharedpref" path="whisper_account_sealed.xml" />
</full-backup-content>
